# Reel Recipes (compose/reel-recipes). Every var is read by the app; see the
# app repo's .env.example for details.
DATA_DIR=/data
# OpenRouter key for the recipe-writing call. The free router costs nothing but
# is capped at a few dozen requests a day on an account without credits.
OPENROUTER_API_KEY=changeme
OPENROUTER_MODEL=openrouter/free
# Shared password for adding, editing and deleting recipes. Reading is open to
# anyone with the link; empty would leave writes open to the internet too.
APP_PASSWORD=changeme
# Language the recipes are written in (de or en).
RECIPE_LANGUAGE=de
# faster-whisper model for the local transcript (tiny, base, small, ...).
WHISPER_MODEL=small
# Optional Netscape cookies file under /data for when Instagram demands a
# login; empty means anonymous downloads.
INSTAGRAM_COOKIES_FILE=
