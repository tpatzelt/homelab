# Mein Pendel (compose/pendel). Every var is read by the app; see the app
# repo's deploy/.pendel.env.example for details.
PENDEL_DATA_DIR=/data
# Telegram bot from @BotFather; leave both empty to disable Telegram.
PENDEL_TELEGRAM_BOT_TOKEN=changeme
PENDEL_TELEGRAM_BOT_USERNAME=changeme_bot
# ntfy server whose topics users subscribe to; empty disables ntfy.
PENDEL_NTFY_URL=https://ntfy.sh
# caddy_network's subnet (docker network inspect caddy_network), so the
# per-IP rate limiter trusts X-Forwarded-For from Caddy only. Never '*'.
FORWARDED_ALLOW_IPS=172.16.0.0/12
