# RomM Environment Variables
# Copy to .romm.env and fill in values

TZ=Europe/Berlin

# Public URL of the instance — used for generated links (QR codes, invites,
# OIDC redirects). Must match the Caddy host, no trailing slash.
ROMM_BASE_URL=https://romm.dev.example.com

# App secret — generate with `openssl rand -hex 32`
ROMM_AUTH_SECRET_KEY=your_64_char_hex_secret

# MariaDB credentials (ROMM_DB_PASSWORD is shared by the app and the db)
ROMM_DB_NAME=romm
ROMM_DB_USER=romm-user
ROMM_DB_PASSWORD=your_secure_db_password
ROMM_DB_ROOT_PASSWORD=your_secure_db_root_password

# Optional metadata providers — Hasheous is on by default and needs no
# account. See https://docs.romm.app/latest/getting-started/metadata-providers/
# SCREENSCRAPER_USER=
# SCREENSCRAPER_PASSWORD=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# STEAMGRIDDB_API_KEY=
# RETROACHIEVEMENTS_API_KEY=
