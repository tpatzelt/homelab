# Caddy Reverse Proxy Environment Variables
# Copy to .caddy.env and fill in values

# Cloudflare API token for DNS-01 ACME challenge
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone:DNS:Edit for your domain
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# CrowdSec bouncer API key for the Caddy CrowdSec module
# Generate on the crowdsec container: docker exec crowdsec cscli bouncers add caddy-bouncer
CROWDSEC_BOUNCER_API_KEY=your_crowdsec_bouncer_api_key

# Base domain for all Caddy host matchers ({$DOMAIN} in the Caddyfile)
# and the goaccess URLs in compose.yaml (${DOMAIN})
DOMAIN=example.com

# Basic-auth credential guarding dozzle.dev.$DOMAIN ({$DOZZLE_AUTH_USER} /
# {$DOZZLE_AUTH_HASH} in the Caddyfile). Dozzle ships no auth in this setup and
# runs with DOZZLE_ENABLE_SHELL + a read-write docker socket, so without this
# anyone on the LAN can open a root shell in any container.
# Generate the hash with:
#   docker exec caddy caddy hash-password --plaintext '<your-password>'
DOZZLE_AUTH_USER=your_dozzle_username
DOZZLE_AUTH_HASH=your_bcrypt_hash

# Basic-auth credential guarding nightshift.dev.$DOMAIN ({$NIGHTSHIFT_AUTH_USER} /
# {$NIGHTSHIFT_AUTH_HASH} in the Caddyfile). The NIGHTSHIFT dashboard queues charters,
# and each one arms agent containers that spend real Claude quota against Tim's
# repositories; the same page pauses, stops and finishes runs. Same escaping rule as
# DOZZLE_AUTH_HASH: every $ in the bcrypt hash MUST be written as $$.
#   docker exec caddy caddy hash-password --plaintext '<new-password>'
NIGHTSHIFT_AUTH_USER=your_nightshift_username
NIGHTSHIFT_AUTH_HASH=your_bcrypt_hash
