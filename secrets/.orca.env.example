# Orca Stack Environment Variables
# Copy to .orca.env and fill in values

# User/group the container runs as. These must match the owner of CODING_DIR
# on the host, or agents cannot write to the repos they are editing.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Orca release to build into the image (matches the upstream .deb asset
# version, without the leading "v"). Renovate cannot see this — it is a build
# arg, not an image tag — so bump it by hand and rebuild:
#   docker compose -f compose/orca/compose.yaml build --pull orca
ORCA_VERSION=1.4.188

# Claude Code release baked into the image — the agent Orca launches into a
# terminal. Like ORCA_VERSION this is a build arg, so neither Renovate nor
# check.sh's pinning report watches it; bump by hand and rebuild. Credentials
# are NOT set here: `claude` authenticates once inside the container and
# stores its token under /home/orca/.claude, which is on the persistent mount.
CLAUDE_CODE_VERSION=2.1.246

# GitHub CLI release baked into the image. Agents use it for PRs and issues,
# and `gh auth setup-git` makes it the git credential helper — the container
# has no SSH key, so that is what authenticates a push. Same build-arg blind
# spot as ORCA_VERSION: bump by hand and rebuild. The GitHub token is NOT set
# here; `gh auth login` runs once inside the container and stores it under
# /home/orca/.config/gh, which is on the persistent mount.
GH_VERSION=2.98.0

# Host directory holding your git repos, bind-mounted into the container at
# the *same* path (see the note in compose.yaml — docker-in-docker depends on
# the paths being identical).
CODING_DIR=/home/youruser/coding

# The address Orca advertises to clients in its pairing offer. It does NOT
# change the bind address; it is only what the laptop dials, so it has to be
# the reachable Caddy hostname. https:// is normalized to wss:// by Orca.
# Must resolve for the client — this host is on the LAN-only *.dev wildcard.
ORCA_PAIRING_ADDRESS=https://orca.dev.example.com
