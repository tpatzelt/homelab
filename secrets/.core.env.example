# Core Services Environment Variables
# Copy to .core.env and fill in values

# User/Group IDs for file permissions
PUID=1000
PGID=1000

# Pi-hole web interface password
PIHOLE_FTLCONF_webserver_api_password=your_secure_password

# Base domain, for the links on the Homepage dashboard (HOMEPAGE_VAR_DOMAIN)
# and its HOMEPAGE_ALLOWED_HOSTS. Same value as DOMAIN in .caddy.env.
DOMAIN=example.com

# Group id of the host's docker group (getent group docker), so the socket
# proxy in front of Dozzle can read /var/run/docker.sock without being root.
DOCKER_GID=988
