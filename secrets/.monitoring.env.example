# Monitoring stack (compose/monitoring): Prometheus + Grafana.
DOMAIN=example.com
# Prometheus and Grafana run as this uid/gid so they can write their
# directories under /opt/dockerdata.
PUID=1000
PGID=1000
# Grafana's first-run admin login. Read only when /opt/dockerdata/grafana is
# empty — after that, change the password in the Grafana UI.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
