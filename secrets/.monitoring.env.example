# Monitoring stack (compose/monitoring): Prometheus + Grafana.
DOMAIN=example.com
# Prometheus and Grafana run as this uid/gid so they can write their
# directories under /opt/dockerdata.
PUID=1000
PGID=1000
# Grafana's first-run admin login. Read only when /opt/dockerdata/grafana is
# empty — after that, change the password in the Grafana UI.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
# Alert e-mail. Gmail needs an app password (Google account → Security →
# 2-Step Verification → App passwords), not the account password.
ALERT_EMAIL=you@example.com
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=you@example.com
GF_SMTP_PASSWORD=changeme
GF_SMTP_FROM_ADDRESS=you@example.com
GF_SMTP_FROM_NAME=Homelab Grafana
