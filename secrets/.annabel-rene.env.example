# annabel-rene frontend environment variables
# Copy to .annabel-rene.env and fill in values

# HMAC secret for the signed session cookie (friends + admin). Generate: openssl rand -hex 32
# Rotating it logs everyone out, including admin.
ANNABEL_RENE_SESSION_SECRET=

# Password for /admin (delete archive entries, curate timeline, set video link
# and tree coordinates). Missing/empty disables the admin area entirely.
ANNABEL_RENE_ADMIN_PASSWORD=

# The shared password friends type on /login. This is its only source — the app
# stores nothing password-related in its database and /admin cannot change it,
# so an empty value locks everyone out. Changing it does not log anyone out
# (sessions are signed with the session secret, not the password).
ANNABEL_RENE_FRIENDS_PASSWORD=

# Riddle shown next to the password field on /login, e.g.
# "In welchem Jahr war die Hochzeit?". Empty renders no hint. It is visible to
# anyone who reaches the login page, so keep it a hint, not the answer.
ANNABEL_RENE_FRIENDS_PASSWORD_HINT=

# Public URL of the site (canonical links, OG tags)
ANNABEL_RENE_PUBLIC_SITE_URL=https://annabel-rene.example.com
