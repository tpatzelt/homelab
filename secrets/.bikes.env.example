# Wie Berlin radelt (compose/bikes). Every var is read by the app; see the app
# repo's deploy/.bikes.env.example for details. BIKES_DATA_DIR/BIKES_SITE_DIR
# are set by compose and must not be set here.

# Required: descriptive User-Agent sent to the nextbike feed and Bright Sky.
BIKES_USER_AGENT=berlin-bike-data/0.1 (+https://github.com/tpatzelt/berlin-bike-data)

# Impressum / Datenschutz details. Required for a public site in Germany; the
# pages show [NAME]/[ANSCHRIFT]/[E-MAIL] placeholders while unset.
BIKES_OPERATOR_NAME=
BIKES_OPERATOR_ADDRESS=
BIKES_OPERATOR_EMAIL=

# Optional: enable the Dott Berlin source (off by default).
BIKES_DOTT_ENABLED=false
