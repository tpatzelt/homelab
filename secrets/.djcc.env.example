# djcc Stack Environment Variables
# Copy to .djcc.env and fill in values

# User/group the container runs as. Must own /opt/dockerdata/djcc/data, or the
# analysis index and the PCM cache cannot be written.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# The crate: a host folder of records, bind-mounted read-only at /music.
# NOT named DJCC_MUSIC_DIR on purpose — that name is read by the app itself
# and env_file injects it into the container, where a host path is wrong.
DJCC_CRATE_DIR=/mnt/storage/data/Media/musik/dj

# What puts Claude behind the decks. Without a credential the booth still plays
# — it falls back to djcc's rule parser — but nothing in it thinks, and the only
# hint is the `djcc doctor` line the entrypoint prints into `docker logs`.
#
# A subscription token (`sk-ant-oat…`, from `claude setup-token`) is the one this
# stack uses: the image carries the `claude` CLI, and djcc drives a headless
# Claude Code with it because that token is scoped to Claude Code and cannot call
# the Messages API at all. An `ANTHROPIC_API_KEY` here instead would take the
# lower-latency SDK path and bill separately.
#
# env_file injects this straight into the container, which is where djcc reads it.
CLAUDE_CODE_OAUTH_TOKEN=
