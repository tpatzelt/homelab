# djcc Stack Environment Variables
# Copy to .djcc.env and fill in values

# User/group the container runs as. Must own /opt/dockerdata/djcc/data, or the
# analysis index and the PCM cache cannot be written.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# The crate: a host folder of records, bind-mounted read-only at /music.
# NOT named DJCC_MUSIC_DIR on purpose — that name is read by the app itself
# and env_file injects it into the container, where a host path is wrong.
DJCC_CRATE_DIR=/mnt/storage/data/Media/musik/dj
