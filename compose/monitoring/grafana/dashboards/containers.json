    {
      "type": "bargauge",
      "title": "Most recently (re)started",
      "description": "Container uptime, shortest first. A crash-looping container sits at the top.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
