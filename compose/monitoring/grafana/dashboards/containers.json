    {
      "type": "timeseries",
      "title": "CPU stall per container (PSI)",
      "description": "Share of time the container had runnable work but no CPU. The noisy neighbours on a 2-core host.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, 100 * sum by (name) (rate(container_pressure_cpu_waiting_seconds_total{name=~\"$container\", container_label_com_docker_compose_project=~\"$stack\"}[$__rate_interval])))",
