      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (class) (label_replace(rate(caddy_http_request_duration_seconds_count{server!=\"srv0\"}[$__rate_interval]), \"class\", \"${1}xx\", \"code\", \"(.)..\"))",
          "legendFormat": "{{class}}",
          "refId": "A"
