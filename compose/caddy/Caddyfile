{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_API_KEY}
		ticker_interval 15s
	}
	order crowdsec first

	servers {
		trusted_proxies static private_ranges
		# The visitor's address comes from Cf-Connecting-Ip, which Cloudflare
		# overwrites on every request. X-Forwarded-For is only the fallback
		# (LAN requests have neither), and strict mode reads it right to left,
		# so a visitor-supplied leftmost entry is never taken as the client.
		# CrowdSec's log parser and the bouncer both key on this value.
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
		trusted_proxies_strict
	}

	# Prometheus metrics, labelled per host so the monitoring stack's
	# dashboards can break traffic down by service. Scraped from :2020 below.
	metrics {
		per_host
	}
}

# Metrics listener for Prometheus (compose/monitoring). Plain HTTP on a port
# that is not published to the host, so only containers on caddy_network and
# public_network can reach it. Deliberately not the admin API (:2019): that one can rewrite
# Caddy's config and stays bound to localhost.
http://:2020 {
	metrics /metrics

	# cloudflared's own /metrics, relayed. cloudflared sits on public_network
	# only and Prometheus on caddy_network only; Caddy is the one container on
	# both, so Prometheus scrapes the tunnel through here instead of either
	# of them joining the other's network.
	handle /cloudflared/metrics {
		rewrite * /metrics
		reverse_proxy cloudflared:2000
	}
}

*.dev.{$DOMAIN} {
	# LAN only. Everything in this block is refused unless the connection
	# itself comes from the LAN. Caddy sees LAN clients with their real
	# 192.168.x.x address, and every container, cloudflared included, with a
	# Docker bridge address in 172.16.0.0/12 (checked against live traffic
	# 2026-11-16). So neither a tunnel ingress rule added by mistake nor a
	# compromised container can reach an internal route through Caddy.
	# remote_ip is the peer address, not the X-Forwarded-For-derived client_ip.
	# This has to be a `handle`, and the first one: a bare `abort @outside`
	# is ordered after the handle blocks below and would never run.
	# Consequence: containers cannot call *.dev names. Point them at the
	# container address instead (http://jellyfin:8096, http://gluetun:8989).
	@outside not remote_ip 192.168.0.0/16
	handle @outside {
		abort
	}

	@dozzle host dozzle.dev.{$DOMAIN}
	handle @dozzle {
		# Dozzle is read-only (no shell, no actions, and a socket proxy that
		# only passes list, inspect, logs, stats and events), but it shows the
		# logs of every container, and logs carry tokens and personal data. It
		# ships no auth of its own here and *.dev resolves LAN-wide, so this
		# basic_auth stays.
		basic_auth {
			{$DOZZLE_AUTH_USER} {$DOZZLE_AUTH_HASH}
		}
		reverse_proxy dozzle:8080
	}

	@pihole host pihole.dev.{$DOMAIN}
	handle @pihole {
		redir / /admin/
		reverse_proxy https://pihole:443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# Homepage dashboard (config in compose/core/homepage/).
	@home host home.dev.{$DOMAIN}
	handle @home {
		reverse_proxy homepage:3000
	}

	@immich host immich.dev.{$DOMAIN}
	handle @immich {
		reverse_proxy immich-server:2283
	}

	@karakeep host karakeep.dev.{$DOMAIN}
	handle @karakeep {
		reverse_proxy karakeep:3000
	}

	# Home Assistant runs on the host network (discovery needs it), so it is
	# reached through the Docker host gateway, not by container name.
	@homeassistant host homeassistant.dev.{$DOMAIN}
	handle @homeassistant {
		reverse_proxy host.docker.internal:8123
	}

	@jellyfin host jellyfin.dev.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096 {
			header_up X-Forwarded-Proto https
		}
	}

	@qb host qbittorrent.dev.{$DOMAIN}
	handle @qb {
		reverse_proxy gluetun:8081
	}

	@prowlarr host prowlarr.dev.{$DOMAIN}
	handle @prowlarr {
		reverse_proxy gluetun:9696
	}

	@seerr host seerr.dev.{$DOMAIN}
	handle @seerr {
		reverse_proxy seerr:5055
	}

	@sonarr host sonarr.dev.{$DOMAIN}
	handle @sonarr {
		reverse_proxy gluetun:8989
	}

	@radarr host radarr.dev.{$DOMAIN}
	handle @radarr {
		reverse_proxy gluetun:7878
	}

	@lidarr host lidarr.dev.{$DOMAIN}
	handle @lidarr {
		reverse_proxy gluetun:8686
	}

	@bazarr host bazarr.dev.{$DOMAIN}
	handle @bazarr {
		reverse_proxy gluetun:6767
	}

	@vault host vaultwarden.dev.{$DOMAIN}
	handle @vault {
		# Vaultwarden 1.29+ uses single port for all traffic including websockets
		reverse_proxy vaultwarden:80 {
			header_up X-Real-IP {remote_host}
		}
	}

	@iptracker host iptracker.dev.{$DOMAIN}
	handle @iptracker {
		reverse_proxy ip-tracker:8000
	}

	@filebrowser host filebrowser.dev.{$DOMAIN}
	handle @filebrowser {
		reverse_proxy filebrowser:80
	}

	@navidrome host navidrome.dev.{$DOMAIN}
	handle @navidrome {
		reverse_proxy navidrome:4533
	}

	# Read-only monitoring UI for the job agent. It ships no authentication of
	# its own, so it must stay on the LAN-only *.dev wildcard.
	@jobagent host jobagent.dev.{$DOMAIN}
	handle @jobagent {
		reverse_proxy job-agent:8765
	}

	# Grafana has its own login (admin credential in secrets/.monitoring.env).
	@grafana host grafana.dev.{$DOMAIN}
	handle @grafana {
		reverse_proxy grafana:3000
	}

	# NIGHTSHIFT — the autonomous Claude Code runner's dashboard. Reaching it
	# means queueing charters: each one arms agent containers that spend real
	# Claude quota against Tim's repositories, and the same page pauses, stops
	# and finishes runs. That is why it carries basic_auth even on the LAN-only
	# *.dev wildcard, the way dozzle does. Regenerate the credential with:
	#   docker exec caddy caddy hash-password --plaintext '<new-password>'
	# and escape every $ in the hash as $$ in compose/caddy/.env.
	#
	# Do not add a cloudflared ingress rule for this host and do not move it to
	# the public *.{$DOMAIN} block.
	@nightshift host nightshift.dev.{$DOMAIN}
	handle @nightshift {
		basic_auth {
			{$NIGHTSHIFT_AUTH_USER} {$NIGHTSHIFT_AUTH_HASH}
		}
		reverse_proxy nightshift-web:8080
	}

	# Catch-all
	handle {
		abort
	}
}

*.{$DOMAIN} {
	route {
		crowdsec
	}

	log {
		output file /var/log/caddy/wildcard-access.log {
			roll_size 50mb
			roll_keep 5
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "none, noarchive, nosnippet, notranslate, noimageindex" # Hides you from Search Engines
		-Server # Hides Caddy from scanners
	}

	# Reached only via the cloudflared tunnel (no public A record, no forwarded ports)
	@annabel-rene host annabel-rene.{$DOMAIN}
	handle @annabel-rene {
		reverse_proxy annabel-rene-frontend:4321
	}

	@jonas host jonas.{$DOMAIN}
	handle @jonas {
		reverse_proxy birthday-bash:80
	}

	@pendel host pendel.{$DOMAIN}
	handle @pendel {
		reverse_proxy pendel-web:8000
	}

	@bikes host bikes.{$DOMAIN}
	handle @bikes {
		reverse_proxy bikes:8080
	}

	@rezepte host rezepte.{$DOMAIN}
	handle @rezepte {
		reverse_proxy reel-recipes:8000
	}

	# Catch-all: Drop unhandled subdomains
	handle {
		abort
	}
}
