{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_API_KEY}
		ticker_interval 15s
	}
	order crowdsec first

	servers {
		trusted_proxies static private_ranges
	}
}

*.dev.{$DOMAIN} {
	@beszel host beszel.dev.{$DOMAIN}
	handle @beszel {
		reverse_proxy beszel:8090
	}

	@dozzle host dozzle.dev.{$DOMAIN}
	handle @dozzle {
		# Dozzle runs with DOZZLE_ENABLE_SHELL + DOZZLE_ENABLE_ACTIONS against a
		# read-write docker socket, so reaching its UI is equivalent to root on the
		# host. It ships no auth of its own here and *.dev resolves LAN-wide, so
		# this basic_auth is the only thing gating that. Do not remove it without
		# disabling those two features first.
		basic_auth {
			{$DOZZLE_AUTH_USER} {$DOZZLE_AUTH_HASH}
		}
		reverse_proxy dozzle:8080
	}

	@pihole host pihole.dev.{$DOMAIN}
	handle @pihole {
		redir / /admin/
		reverse_proxy https://pihole:443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@heimdall host heimdall.dev.{$DOMAIN}
	handle @heimdall {
		reverse_proxy heimdall:80
	}

	@immich host immich.dev.{$DOMAIN}
	handle @immich {
		reverse_proxy immich-server:2283
	}

	@karakeep host karakeep.dev.{$DOMAIN}
	handle @karakeep {
		reverse_proxy karakeep:3000
	}

	@jellyfin host jellyfin.dev.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096 {
			header_up X-Forwarded-Proto https
		}
	}

	@qb host qbittorrent.dev.{$DOMAIN}
	handle @qb {
		reverse_proxy gluetun:8081
	}

	@prowlarr host prowlarr.dev.{$DOMAIN}
	handle @prowlarr {
		reverse_proxy gluetun:9696
	}

	@seerr host seerr.dev.{$DOMAIN}
	handle @seerr {
		reverse_proxy seerr:5055
	}

	@sonarr host sonarr.dev.{$DOMAIN}
	handle @sonarr {
		reverse_proxy gluetun:8989
	}

	@radarr host radarr.dev.{$DOMAIN}
	handle @radarr {
		reverse_proxy gluetun:7878
	}

	@lidarr host lidarr.dev.{$DOMAIN}
	handle @lidarr {
		reverse_proxy gluetun:8686
	}

	@bazarr host bazarr.dev.{$DOMAIN}
	handle @bazarr {
		reverse_proxy gluetun:6767
	}

	@vault host vaultwarden.dev.{$DOMAIN}
	handle @vault {
		# Vaultwarden 1.29+ uses single port for all traffic including websockets
		reverse_proxy vaultwarden:80 {
			header_up X-Real-IP {remote_host}
		}
	}

	@iptracker host iptracker.dev.{$DOMAIN}
	handle @iptracker {
		reverse_proxy ip-tracker:8000
	}

	@goaccess host goaccess.dev.{$DOMAIN}
	handle @goaccess {
		# 1. Proxy the WebSocket explicitly first
		handle /ws {
			reverse_proxy goaccess:7890
		}

		# 2. Serve static files for everything else
		handle {
			root * /var/www/goaccess
			file_server
		}
	}

	@filebrowser host filebrowser.dev.{$DOMAIN}
	handle @filebrowser {
		reverse_proxy filebrowser:80
	}

	@navidrome host navidrome.dev.{$DOMAIN}
	handle @navidrome {
		reverse_proxy navidrome:4533
	}

	@romm host romm.dev.{$DOMAIN}
	handle @romm {
		reverse_proxy romm:8080
	}

	# Read-only monitoring UI for the job agent. It ships no authentication of
	# its own, so it must stay on the LAN-only *.dev wildcard.
	@jobagent host jobagent.dev.{$DOMAIN}
	handle @jobagent {
		reverse_proxy job-agent:8765
	}

	# Orca ADE. Port 6768 carries two things: the runtime WebSocket, and the
	# browser client Orca serves at /web-index.html. One reverse_proxy covers
	# both — Caddy upgrades the WebSocket transparently. Note that the bare
	# path / is not a page; the way in is the "Web client URL" printed at
	# startup, which carries the pairing offer in its URL fragment.
	#
	# Reaching a paired Orca runtime means running arbitrary commands as the
	# service account, in the bind-mounted coding tree, against the stack's
	# docker-in-docker daemon. Orca authenticates clients itself with
	# per-device revocable pairing tokens, so this is not the unauthenticated
	# case dozzle is — but upstream is explicit that the port must not be
	# exposed to the internet. Keeping it on the LAN-only *.dev wildcard is
	# that constraint: do not add an ingress rule for it in cloudflared's
	# config.yml, and do not move it to the public *.{$DOMAIN} block.
	@orca host orca.dev.{$DOMAIN}
	handle @orca {
		reverse_proxy orca:6768
	}

	# djcc — the DJ booth. Every control on the page is live and there is no
	# authentication of any kind: whoever loads it can retune, reload or stop
	# the set. The LAN-only *.dev wildcard is the only thing gating that, so do
	# not add a cloudflared ingress rule for this host or move it to the public
	# block.
	@djcc host djcc.dev.{$DOMAIN}
	handle @djcc {
		# Two long-lived responses share this upstream: /ws (a 15 Hz state feed)
		# and /stream.mp3 (a live MP3 that never ends). flush_interval -1 turns
		# off response buffering for both — with buffering the browser's audio
		# element waits on a full buffer before it plays anything.
		reverse_proxy djcc:8765 {
			flush_interval -1
		}
	}

	# Catch-all
	handle {
		abort
	}
}

*.{$DOMAIN} {
	route {
		crowdsec
	}

	log {
		output file /var/log/caddy/wildcard-access.log {
			roll_size 50mb
			roll_keep 5
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "none, noarchive, nosnippet, notranslate, noimageindex" # Hides you from Search Engines
		-Server # Hides Caddy from scanners
	}

	# Reached only via the cloudflared tunnel (no public A record, no forwarded ports)
	@annabel-rene host annabel-rene.{$DOMAIN}
	handle @annabel-rene {
		reverse_proxy annabel-rene-frontend:4321
	}

	@jonas host jonas.{$DOMAIN}
	handle @jonas {
		reverse_proxy birthday-bash:80
	}

	# Catch-all: Drop unhandled subdomains
	handle {
		abort
	}
}
