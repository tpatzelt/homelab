[Unit]
Description=Daily full-system snapshot of popbook to lindus

[Timer]
OnCalendar=*-*-* 21:00:00
RandomizedDelaySec=30m
# The point of this on a laptop: a run missed while off/asleep/away fires
# shortly after the next boot instead of being silently skipped.
Persistent=true

[Install]
WantedBy=timers.target
